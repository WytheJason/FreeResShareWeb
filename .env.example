# ============================================================
# 环梦网盘资源分享论坛 - 环境变量模板
# 使用时复制为 .env.local 并填入实际值
# ============================================================

# ---------- Supabase 配置 ----------
# Supabase 项目 URL（Dashboard > Project Settings > API > Project URL）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon 公钥（客户端使用，公开可读，受 RLS 保护）
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service_role 服务密钥（仅服务端使用，绕过 RLS，严格保密！）
# 路径：Dashboard > Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------- 极验 GeeTest 4 配置 ----------
# 极验后台 > 账号管理 > ID & KEY
# 验证 ID（公开，前端 SDK 使用）
NEXT_PUBLIC_GEETEST_CAPTCHA_ID=your-captcha-id
# 验证 ID（仅服务端使用，与上方相同值；后端优先读此变量，避免依赖前端变量配置）
GEETEST_CAPTCHA_ID=your-captcha-id
# 验证 KEY（仅服务端使用，严格保密！）
GEETEST_CAPTCHA_KEY=your-captcha-key

# ---------- 站点配置 ----------
# 网站部署地址（用于 SEO 与邮件链接）
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ICP 备案号（如有，留空则不显示）
NEXT_PUBLIC_ICP_NUMBER=

# 管理员初始邮箱（首次部署后，将此邮箱对应用户在 Supabase 中手动置 is_admin=true）
ADMIN_INITIAL_EMAIL=admin@example.com

# ---------- 易支付（EPay）配置 ----------
# 商户ID（易支付后台获取）
EPAY_PID=your-merchant-id
# 商户密钥（MD5签名使用，严格保密）
EPAY_KEY=your-merchant-key
# 易支付网关地址
EPAY_API_URL=https://api.zhunfu.cn

# ---------- Google AdSense 配置 ----------
# AdSense 发布商 ID（在 AdSense 后台 > 账号 > 发布商 ID 获取）
# 已内置默认值 ca-pub-5863972767779385，如需更换在此覆盖
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-5863972767779385

# 广告单元 ID（AdSense 后台 > 广告 > 广告单元 > 创建后获取 data-ad-slot）
# 留空则对应位置显示"广告位占位"，填入 ID 后展示真实广告
# 首页顶部广告位（搜索框下、置顶资源上；列表视图底部也复用此 slot）
NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=
# 首页信息流广告位（最新资源与热门资源分区之间）
NEXT_PUBLIC_ADSENSE_SLOT_HOME_INFEED=
# 帖子详情页广告位（帖子内容与评论区之间）
NEXT_PUBLIC_ADSENSE_SLOT_POST=
